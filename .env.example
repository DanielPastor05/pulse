# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server-only. Never expose. Used for realtime broadcast + signed uploads.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ---------------------------------------------------------------------------
# Postgres — Project Settings → Database → Connection string
#
# Locally, point both at the direct connection. For serverless deployments
# switch DATABASE_URL to the transaction pooler (port 6543) and keep DIRECT_URL
# on the direct one — `prisma db push` cannot run through the pooler.
#
# Percent-encode any special characters in the password.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# App
#
# Optional. Invite links derive their origin from the request, so nothing
# breaks if this is unset. Set it only to allow an extra origin through the
# CSRF check — no trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — enables the GIF and sticker picker (https://developers.giphy.com)
#
# GIPHY and not Tenor: Tenor stopped accepting new API clients in January
# 2026 and its docs announce the service winding down, so that integration
# could only be used by whoever already had a key.
#
# A new key starts as a beta key, rate limited to 100 calls per hour, which
# is plenty for a demo and worth knowing before you wonder why it stops.
GIPHY_API_KEY=""

# ---------------------------------------------------------------------------
# Web Push (VAPID) — optional. Without these, notifications still work while
# the app is open, but nothing reaches a closed tab.
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Server-only. Never expose.
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ---------------------------------------------------------------------------
# Error monitoring (Sentry) — optional. Without a DSN the app runs exactly the
# same, just without reports. Message content, query strings, cookies and
# headers are stripped before anything is sent; see src/lib/sentry-scrub.ts.
# ---------------------------------------------------------------------------
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Calls (TURN relay) — optional, but its absence is not harmless: without a
# relay, calls fail between most mobile networks and many home routers, where
# symmetric NAT prevents a direct path. STUN alone only covers the easy cases.
#
# Server-only on purpose. Cloudflare does not issue a fixed username and
# password: this token mints short-lived credentials against your quota, so
# in the browser it would be quota anyone could spend. The app exposes
# /api/calls/ice instead, behind auth.
# Create one at Cloudflare -> Realtime -> TURN.
# ---------------------------------------------------------------------------
CLOUDFLARE_TURN_TOKEN_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# ---------------------------------------------------------------------------
# Limpieza programada — opcional. Vercel manda este valor en `Authorization`
# al disparar el cron de vercel.json. Sin él la tarea se niega a ejecutarse:
# un endpoint que borra ficheros y no comprueba quién llama es peor que no
# tener limpieza. Genera uno con: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Workers AI - los embeddings de la busqueda semantica. Opcional: sin esto la
# rama vectorial se apaga y la busqueda sigue funcionando solo con la lexica,
# que es degradarse y no romperse.
#
# Server-only, por lo mismo que el token de TURN: gasta la cuota de neuronas de
# la cuenta, asi que en el navegador seria la cuota de cualquiera.
#
# El panel los da los dos juntos en AI -> Workers AI -> "Use REST API". Si se
# crea el token a mano, el permiso exacto es Account -> Workers AI -> Read; uno
# con permisos de AI Gateway devuelve 401 con codigo 10000.
#
# Coste: 1075 neuronas por millon de tokens, con 10 000 gratis al dia. Embeber
# los 1828 mensajes de este proyecto costo 22.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
