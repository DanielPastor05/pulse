{
  "name": "pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "//overrides": "next 15 has no advisory of its own — npm flags it only for pulling in a vulnerable sharp and postcss. Pinning those two directly closes the CVEs without a major framework bump the night before a launch. Drop this block once Next ships a release that already depends on patched versions.",
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.26",
    "deepmerge-ts": "^8.0.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"tests/unit/*.test.ts\"",
    "test:component": "cross-env TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --import ./tests/component/setup.ts --test \"tests/component/*.test.tsx\"",
    "test:integration": "node --conditions=react-server --import tsx --test \"tests/integration/*.test.ts\"",
    "test:covered": "npm test && npm run test:component && npm run test:integration",
    "coverage": "c8 npm run test:covered",
    "test:smoke": "playwright test",
    "test:e2e": "node tests/e2e/security.mjs && node tests/e2e/authorization.mjs && node tests/e2e/abuse.mjs && node tests/e2e/realtime-authz.mjs && node tests/e2e/notifications.mjs && node tests/e2e/realtime.mjs && node tests/e2e/push.mjs",
    "bench:search": "node tests/bench/search.mjs",
    "bench:quality": "node tests/bench/search-quality.mjs",
    "bench:models": "node tests/bench/embedding-models.mjs",
    "bench:breakdown": "node tests/bench/search-breakdown.mjs",
    "bench:load": "node tests/bench/load.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.13.4",
    "framer-motion": "^12.23.22",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@happy-dom/global-registrator": "^20.11.6",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "happy-dom": "^20.11.6",
    "prisma": "^6.16.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
