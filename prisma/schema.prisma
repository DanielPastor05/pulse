// Pulse — database schema
// Postgres (Supabase). Auth lives in Supabase `auth.users`; `User.id` mirrors that uuid.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Presence {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum Locale {
  EN
  ES
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MessageKind {
  TEXT
  SYSTEM
  POLL
}

enum AttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  VOICE
  DOCUMENT
}

enum RelationshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  SEXUAL
  SELF_HARM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationKind {
  MESSAGE
  MENTION
  REACTION
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_INVITE
  JOIN_REQUEST
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String  @id @db.Uuid
  email       String  @unique
  username    String  @unique
  displayName String
  avatarUrl   String?
  bannerColor String  @default("violet")
  bio         String?
  statusText  String?

  /// El asistente es una cuenta como las demás, con esta marca encima.
  ///
  /// Una cuenta de verdad y no un caso especial en cada consulta: así el hilo,
  /// la lista, las notificaciones, la búsqueda y los permisos lo tratan como a
  /// cualquiera, sin una rama nueva en ninguno. Lo único que necesita saber el
  /// resto del programa es que no hay una persona detrás — para ponerle una
  /// etiqueta, y para no contestarse a sí mismo.
  isAssistant Boolean @default(false)

  presence   Presence @default(OFFLINE)
  lastSeenAt DateTime @default(now())

  /// El idioma de la interfaz. La cookie lo repite para las pantallas que se
  /// pintan antes de que haya sesion; esta fila es la que manda.
  locale        Locale          @default(EN)
  theme         ThemePreference @default(SYSTEM)
  accent        String          @default("violet")
  reducedMotion Boolean         @default(false)

  notifyOnMessage   Boolean @default(true)
  notifyOnMention   Boolean @default(true)
  notifyOnReaction  Boolean @default(false)
  notifySounds      Boolean @default(true)
  notifyDesktopPush Boolean @default(true)

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships           ConversationMember[]
  messages              Message[]
  reactions             Reaction[]
  stars                 StarredMessage[]
  pinnedMessages        Message[]            @relation("MessagePinnedBy")
  ownedConversations    Conversation[]       @relation("ConversationOwner")
  sentRelationships     Relationship[]       @relation("RelationshipRequester")
  receivedRelationships Relationship[]       @relation("RelationshipAddressee")
  blocksMade            Block[]              @relation("BlockAuthor")
  blocksReceived        Block[]              @relation("BlockTarget")
  joinRequests          JoinRequest[]
  notifications         Notification[]       @relation("NotificationOwner")
  notificationsSent     Notification[]       @relation("NotificationActor")
  invites               Invite[]
  pushSubscriptions     PushSubscription[]
  pollVotes             PollVote[]
  moderationActions     ModerationEvent[]    @relation("ModerationActor")
  moderationAgainst     ModerationEvent[]    @relation("ModerationTarget")
  reportsFiled          Report[]             @relation("ReportsFiled")
  reportsAgainst        Report[]             @relation("ReportsAgainst")
  reportsReviewed       Report[]             @relation("ReportsReviewed")
  scheduledMessages     ScheduledMessage[]

  @@index([username])
  @@index([displayName])
  // Trigram indexes back the `contains` (ILIKE '%…%') searches. Declared here
  // as well as in sql/security.sql so `prisma db push` never drops them.
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_display_name_trgm_idx")
  @@map("users")
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id               String           @id @default(uuid()) @db.Uuid
  type             ConversationType
  name             String?
  slug             String?          @unique
  description      String?
  avatarUrl        String?
  accent           String           @default("violet")
  isPublic         Boolean          @default(false)
  requiresApproval Boolean          @default(false)

  ownerId String? @db.Uuid
  owner   User?   @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members           ConversationMember[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  joinRequests     JoinRequest[]
  moderationEvents ModerationEvent[]
  invites          Invite[]
  notifications    Notification[]
  reports          Report[]

  @@index([type, isPublic])
  @@index([lastMessageAt])
  @@index([ownerId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "conversations_name_trgm_idx")
  @@map("conversations")
}

model ConversationMember {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     MemberRole @default(MEMBER)
  nickname String?

  muted    Boolean @default(false)
  favorite Boolean @default(false)
  archived Boolean @default(false)
  draft    String?

  /// El fondo del hilo, elegido por cada persona y no por el grupo.
  ///
  /// Va aquí y no en `Conversation` a propósito: es una preferencia de quien
  /// mira, como el silencio o el archivado. Ponerlo en la conversación dejaría
  /// que un miembro le cambiara el fondo a los demás, que es una forma rara de
  /// molestar y ninguna de personalizarse a uno mismo.
  ///
  /// Guarda el identificador de un fondo del catálogo, no una URL: una imagen
  /// arbitraria detrás del texto se lee mal la mitad de las veces, y admitirla
  /// abriría otra superficie de subida que vigilar.
  background String?

  lastReadAt        DateTime?
  lastReadMessageId String?   @db.Uuid

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId, archived])
  @@map("conversation_members")
}

/// Un mensaje escrito ahora para que salga más tarde.
///
/// Tabla aparte y no un `Message` con fecha futura. Un mensaje sin enviar en la
/// tabla de mensajes se cuela en todo lo que la lee: el recuento de sin leer, la
/// vista previa de la lista, la búsqueda, el hilo, los índices vectoriales. Cada
/// una de esas consultas tendría que aprender a excluirlo, y la que se olvidara
/// enseñaría el mensaje antes de tiempo. Aquí no hay nada que excluir.
///
/// Sólo texto. Un adjunto programado obligaría a sostener un fichero subido que
/// todavía no pertenece a ningún mensaje, con su propia limpieza y su propio
/// permiso de lectura. Lo que la gente programa son palabras.
model ScheduledMessage {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content   String
  replyToId String? @db.Uuid

  scheduledFor DateTime

  /// El reclamo. Se marca antes de enviar, para que dos peticiones simultáneas
  /// no cojan la misma fila; se vuelve a permitir a los cinco minutos por si
  /// quien la cogió murió a medias. Ese reintento no puede duplicar el mensaje
  /// porque el envío va con `clientId`, y ahí ya hay una restricción única.
  claimedAt DateTime?

  /// Lo que salió: o el mensaje enviado, o el motivo de que no.
  sentMessageId String? @db.Uuid
  failedReason  String?

  createdAt DateTime @default(now())

  @@index([scheduledFor])
  @@index([authorId, conversationId])
  @@map("scheduled_messages")
}

// ---------------------------------------------------------------------------
// Messages
// ---------------------------------------------------------------------------

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  kind    MessageKind @default(TEXT)
  content String      @default("")

  /// Columna generada, la mantiene Postgres a partir de `content`. La declara
  /// el esquema para que una regeneración no la borre, pero la aplicación no la
  /// escribe nunca: intentarlo sería un error del motor.
  searchVector Unsupported("tsvector")?

  /// La mitad vectorial de la busqueda. A diferencia de `searchVector`, esta no
  /// se calcula sola: la escribe `embedding.service` fuera del camino de la
  /// respuesta, y lo que quede a NULL lo recoge la tarea programada. Prisma no
  /// sabe leer ni escribir `vector`, asi que ambas cosas van por SQL crudo.
  embedding Unsupported("vector(1024)")?

  replyToId String?   @db.Uuid
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  forwardedFromId String?   @db.Uuid
  forwardedFrom   Message?  @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        Message[] @relation("MessageForwards")

  editedAt   DateTime?
  deletedAt  DateTime?
  pinnedAt   DateTime?
  pinnedById String?   @db.Uuid
  pinnedBy   User?     @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)

  /// Idempotency key minted by the sender. Retrying a message that may or may
  /// not have arrived is the whole point of the retry affordance, so the second
  /// attempt has to resolve to the same row rather than post twice. Scoped to
  /// the author so two people cannot collide on the same value.
  clientId String? @db.VarChar(64)

  linkPreviewId String?      @db.Uuid
  linkPreview   LinkPreview? @relation(fields: [linkPreviewId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  attachments   Attachment[]
  reactions     Reaction[]
  stars         StarredMessage[]
  mentions      Mention[]
  notifications Notification[]
  reports       Report[]
  poll          Poll?

  // Postgres treats NULLs as distinct, so messages sent without a clientId are
  // unaffected by this constraint.
  @@unique([authorId, clientId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, pinnedAt])
  // Covering indexes for the outgoing foreign keys — without them every
  // cascade delete degrades into a sequential scan of this table.
  @@index([authorId])
  @@index([replyToId])
  @@index([forwardedFromId])
  @@index([pinnedById])
  @@index([linkPreviewId])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "messages_content_trgm_idx")
  @@map("messages")
}

/// Open Graph metadata for a shared link, cached by URL rather than by message:
/// the same link pasted ten times is fetched once.
///
/// Failures are cached too. Without that, a dead or deliberately slow host
/// would be re-fetched every time somebody shares it.
model LinkPreview {
  id  String @id @default(uuid()) @db.Uuid
  /// Capped so the unique index stays inside Postgres's btree row limit even
  /// with multi-byte characters.
  url String @unique @db.VarChar(512)

  title       String? @db.VarChar(300)
  description String? @db.VarChar(600)
  imageUrl    String? @db.VarChar(2048)
  siteName    String? @db.VarChar(120)

  failed    Boolean  @default(false)
  fetchedAt DateTime @default(now())

  messages Message[]

  @@map("link_previews")
}

model Attachment {
  id String @id @default(uuid()) @db.Uuid

  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind     AttachmentKind
  url      String
  path     String
  name     String
  size     Int
  mimeType String
  width    Int?
  height   Int?
  duration Int?
  waveform Float[]        @default([])
  blurhash String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "attachments_name_trgm_idx")
  @@map("attachments")
}

model Reaction {
  id String @id @default(uuid()) @db.Uuid

  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("reactions")
}

model StarredMessage {
  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId, createdAt])
  @@map("starred_messages")
}

model Mention {
  id String @id @default(uuid()) @db.Uuid

  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @db.Uuid

  @@unique([messageId, userId])
  @@index([userId])
  @@map("mentions")
}

// ---------------------------------------------------------------------------
// Social graph
// ---------------------------------------------------------------------------

model Relationship {
  id String @id @default(uuid()) @db.Uuid

  requesterId String @db.Uuid
  requester   User   @relation("RelationshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String @db.Uuid
  addressee   User   @relation("RelationshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status    RelationshipStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("relationships")
}

model Block {
  blockerId String @db.Uuid
  blocker   User   @relation("BlockAuthor", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String @db.Uuid
  blocked   User   @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model JoinRequest {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message   String?
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId, status])
  @@index([userId])
  @@map("join_requests")
}

/// A poll, hanging off the message that announced it.
///
/// Attached to a `Message` with kind `POLL` rather than being its own top-level
/// thing: a poll *is* a message — it is pinned, replied to, searched and
/// deleted like any other, and modelling it separately would mean teaching all
/// of that about a second kind of entity.
model Poll {
  id String @id @default(uuid()) @db.Uuid

  messageId String  @unique @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  question String @db.VarChar(300)

  /// Whether one person may pick several answers.
  multiple Boolean   @default(false)
  /// Closed polls keep their results but take no more votes.
  closedAt DateTime?

  createdAt DateTime @default(now())

  options PollOption[]

  @@map("polls")
}

model PollOption {
  id String @id @default(uuid()) @db.Uuid

  pollId String @db.Uuid
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  label    String @db.VarChar(150)
  /// Keeps the author's order rather than whatever the database returns.
  position Int

  votes PollVote[]

  @@index([pollId, position])
  @@map("poll_options")
}

enum ModerationAction {
  MEMBER_REMOVED
  ROLE_CHANGED
  MESSAGE_DELETED
  REPORT_REVIEWED
}

/// Quién hizo qué, en moderación.
///
/// Sólo se añade: no hay endpoint que edite ni borre, y RLS deniega UPDATE y
/// DELETE. Un registro que el moderador puede reescribir no sirve para lo único
/// que sirve un registro.
model ModerationEvent {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// `SetNull` como el autor de un mensaje: el historial sobrevive a la cuenta
  /// de quien actuó. Uno que se vacía cuando el responsable se va no es un
  /// historial, así que el nombre queda copiado abajo en el momento del hecho.
  actorId   String? @db.Uuid
  actor     User?   @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String

  /// Puede no haber persona señalada: revisar una denuncia no apunta a nadie.
  targetId   String? @db.Uuid
  target     User?   @relation("ModerationTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetName String?

  action ModerationAction
  /// Qué cambió exactamente: el rol nuevo, el motivo de la denuncia, el id del
  /// mensaje. Texto libre porque cada acción cuenta algo distinto.
  detail String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("moderation_events")
}

model PollVote {
  id String @id @default(uuid()) @db.Uuid

  optionId String     @db.Uuid
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// La encuesta a la que pertenece este voto, **sólo si admite una respuesta**.
  ///
  /// Existe para que «un voto por encuesta» sea una restricción y no una regla
  /// de la aplicación. Antes vivía en el servicio, que leía y luego escribía: dos
  /// toques simultáneos en opciones distintas se intercalaban y dejaban dos votos
  /// en una pregunta de respuesta única.
  ///
  /// Es null cuando la encuesta admite varias, y Postgres considera distintos
  /// dos NULL en un índice único — así que la misma restricción no estorba a las
  /// de opción múltiple, que sí deben poder acumular votos.
  singleChoicePollId String? @db.Uuid

  /// Votar dos veces la misma opción es un doble clic, no dos votos.
  @@unique([optionId, userId])
  @@unique([userId, singleChoicePollId])
  @@index([userId])
  @@map("poll_votes")
}

/// One browser's permission to be woken up.
///
/// Per device, not per user: somebody signed in on a phone and a laptop has two
/// of these, and a notification has to reach both. The endpoint is the identity
/// — the push service mints it, and it is what a delivery is addressed to.
model PushSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Unique across users on purpose: if a device is handed over to somebody
  /// else, the row moves rather than delivering one person's messages to
  /// another's screen.
  endpoint String @unique @db.VarChar(512)
  p256dh   String @db.VarChar(200)
  auth     String @db.VarChar(100)

  /// Rough label for the settings screen ("Chrome on Android").
  label String? @db.VarChar(120)

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// A message flagged for a moderator's attention.
///
/// Blocking already existed but it is a private, all-or-nothing tool: it hides
/// one person from one person and leaves nobody else any the wiser. In a public
/// community that means a moderator never finds out anything is wrong.
///
/// The reported message is kept as a nullable reference: if the author deletes
/// it, the report survives rather than vanishing along with the evidence.
model Report {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId String?  @db.Uuid
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  reporterId String @db.Uuid
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  /// Denormalised so the report still says who it was about after an account
  /// is deleted and the row below goes null.
  reportedUserId String? @db.Uuid
  reportedUser   User?   @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason ReportReason
  note   String?      @db.VarChar(500)

  status       ReportStatus @default(OPEN)
  reviewedById String?      @db.Uuid
  reviewedBy   User?        @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  /// One report per person per message: reporting twice is a slip, not a
  /// stronger signal.
  @@unique([messageId, reporterId])
  @@index([conversationId, status, createdAt(sort: Desc)])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([reviewedById])
  @@map("reports")
}

model Invite {
  id String @id @default(uuid()) @db.Uuid

  code String @unique

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId])
  @@index([createdById])
  @@map("invites")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)

  actorId String? @db.Uuid
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  kind  NotificationKind
  title String
  body  String?

  conversationId String?       @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId String?  @db.Uuid
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([conversationId])
  @@index([messageId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Rate limiting
// ---------------------------------------------------------------------------

/// Fixed-window counters shared by every app instance. Lives in Postgres so a
/// limit still holds when the app runs on more than one process — an in-memory
/// counter resets on each cold start and is per-instance, which on serverless
/// means effectively no limit at all.
model RateLimit {
  key String @id

  /// timestamptz, unlike the rest of the schema: this is the one column that
  /// gets compared against `now()` from several processes at once, so it must
  /// not depend on each connection's session timezone.
  windowStart DateTime @default(now()) @db.Timestamptz(6)
  count       Int      @default(0)

  /// Cuántas hubo en la ventana anterior. El contador deslizante la pondera por
  /// la parte que todavía solapa, y eso es lo que impide gastar la cuota dos
  /// veces seguidas a caballo de un corte.
  prevCount   Int      @default(0)

  @@index([windowStart], map: "rate_limits_windowstart_idx")
  @@map("rate_limits")
}

/// Embeddings de consultas ya calculados.
///
/// Existe para no pagar un viaje a la funcion de embeddings en cada busqueda.
/// La clave es el texto normalizado, no el original.
model QueryEmbedding {
  query     String                     @id
  embedding Unsupported("vector(1024)")
  createdAt DateTime                   @default(now())
  usedAt    DateTime                   @default(now())

  @@index([usedAt])
  @@map("query_embeddings")
}

/// Una fila por peticion servida, para poder calcular percentiles.
///
/// Muestras crudas y no un histograma de cubos: a este volumen
/// `percentile_cont` da el percentil exacto en vez de una aproximacion. El
/// techo esta dicho en el README. La escribe el servidor por SQL crudo desde
/// `after()`, nunca el cliente.
model RequestSample {
  id     BigInt   @id @default(autoincrement())
  route  String
  method String
  status Int      @db.SmallInt
  ms     Int
  at     DateTime @default(now())

  @@index([at(sort: Desc)])
  @@index([route, at(sort: Desc)])
  @@map("request_samples")
}

/// Candados con caducidad: cuando se comprobaron los percentiles por ultima
/// vez, y cuando salto el aviso de cada ruta.
model MetricsState {
  key String   @id
  at  DateTime @default(now())

  @@map("metrics_state")
}

/// Lo que mide el navegador y el servidor no puede medir.
///
/// Tabla propia y no `request_samples` porque CLS no son milisegundos: es una
/// puntuacion sin unidad entre 0 y 1, y en una columna de enteros seria
/// siempre cero.
model WebVital {
  id     BigInt   @id @default(autoincrement())
  metric String
  value  Float
  rating String
  path   String
  at     DateTime @default(now())

  @@index([at(sort: Desc)])
  @@index([metric, at(sort: Desc)])
  @@map("web_vitals")
}
